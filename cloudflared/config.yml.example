# =================================================================
# Cloudflare Tunnel — template LocalRouter (Gateway + OCR)
#
# Questo server unifica il gateway OpenAI-compat e il server OCR
# su un unico processo e un unico tunnel.
#
# Passi:
#   1. cloudflared tunnel create localrouter
#   2. cloudflared tunnel route dns localrouter <hostname>
#   3. Copia questo file come config.yml e personalizza
#   4. cloudflared --config cloudflared\config.yml tunnel run
#
# Per installare come servizio Windows (PowerShell admin):
#   cloudflared --config cloudflared\config.yml service install
# =================================================================

tunnel: REPLACE_WITH_TUNNEL_UUID
credentials-file: C:\Users\<TUO_UTENTE>\.cloudflared\REPLACE_WITH_TUNNEL_UUID.json

ingress:
  - hostname: localrouter.example.com
    service: http://127.0.0.1:8088
    originRequest:
      noTLSVerify: true
      connectTimeout: 30s
      tcpKeepAlive: 30s
      # Lasciare alto: l'OCR di PDF multipagina puo' impiegare minuti.
      httpHostHeader: localrouter.example.com
  - service: http_status:404
