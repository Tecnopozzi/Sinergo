# =================================================================
# LocalRouter — Gateway OpenAI-compat + OCR Server — configurazione
# Copia questo file in `.env` e personalizza i valori.
# =================================================================

# ---------------------------------------------------------------
# Autenticazione e rete
# ---------------------------------------------------------------

# Chiave API richiesta negli header Authorization: Bearer <key> o X-API-Key: <key>.
# Lasciare vuoto per disabilitare l'autenticazione (utile in LAN o fase test).
# Se valorizzata, e' richiesta su /v1/* e /process /status /result.
# /health e' sempre pubblico (09B lo chiama senza auth).
API_KEY=

# Host Ollama locale.
OLLAMA_HOST=http://127.0.0.1:11434

# Nome identificativo di questa istanza LocalRouter (con piu' server su macchine diverse).
# Vuoto = derivato dall'hostname (es. "LocalRouter-<hostname>"). Mostrato in dashboard, /health e /llm/context.
SERVER_NAME=

# GPU disponibile su questo PC (informativa): mostrata nella dashboard e in /llm/context
# per aiutare un LLM orchestratore a scegliere i modelli. Testo libero.
# Esempio: NVIDIA GeForce RTX 3060 12GB VRAM
GPU_INFO=

# Interfaccia e porta di ascolto FastAPI.
# Stessa porta del gateway OpenAI-compat precedente, se lo sostituisci.
HOST=127.0.0.1
PORT=8088
# Solo LOCALROUTER_MODO=client: porte locali aggiuntive per apparire come
# LM Studio/Ollama nativi. Default vuoto: non occupa 1234/11434.
# LOCALROUTER_CLIENT_EXTRA_PORTS=1234,11434

# Origin CORS ammesse (separate da virgola). "*" permissivo, restringi in produzione.
ALLOW_ORIGINS=*

# Rate limit: richieste al minuto per token/IP (0 = disabilitato).
RATE_LIMIT_PER_MINUTE=120

# Keep-alive Ollama per le chat: mantiene il modello in VRAM tra una richiesta e l'altra.
# Ollama scarica dopo 5 min di default; "30m" evita di ricaricare il modello (GB da disco)
# a ogni domanda. Esempi: "30m", "1h", "-1" (per sempre). Vuoto = default Ollama.
CHAT_OLLAMA_KEEP_ALIVE=30m

# --- Pull + restart remoto (opzionale) ---
# Se valorizzato, registra POST /admin/pull-restart (202): git pull su main + riavvio processo sulla PORT.
# Token DEDICATO (consigliato lungo e diverso da API_KEY). Header:
#   X-Pull-Restart-Token: <valore>   oppure   Authorization: Bearer <valore>
# Vuoto = endpoint disattivato.
PULL_RESTART_HTTP_KEY=
# Secondi prima che il worker esegua git/kill (dopo la risposta HTTP al chiamante).
PULL_RESTART_PREDELAY_S=3
# Minimo intervallo tra due richieste ammesse (0 = disabilitato).
PULL_RESTART_COOLDOWN_S=120
# Root del repository git. Vuoto = due directory sopra il progetto (default).
# PULL_RESTART_REPO_ROOT=C:\path\to\git-root

# Timeout (secondi) per chiamate chat verso Ollama.
OLLAMA_TIMEOUT_S=600

# ---------------------------------------------------------------
# Backend LLM: llama-swap (produzione) oppure LM Studio Local Server
# ---------------------------------------------------------------
#
# Dall'11/08/2026 la macchina 5060 gira in PROXY PURO verso llama-swap:
#   LMSTUDIO_HOST=http://127.0.0.1:8093
#   LMSTUDIO_PROXY_PURE=1
# LM Studio resta installato come catalogo dei GGUF e via di ritorno
# (LMSTUDIO_PROXY_PURE=0 + LMSTUDIO_HOST=http://127.0.0.1:1234).
# Il prefisso degli id (`lmstudio:`) NON cambia in nessuno dei due casi:
# i client hanno quegli id in configurazione.

# Abilitare questo backend come sorgente di modelli.
# 1 = abilitato (default), 0 = disabilitato.
LMSTUDIO_ENABLED=1

# URL del backend: llama-swap (:8093) oppure LM Studio Local Server (:1234).
LMSTUDIO_HOST=http://127.0.0.1:8093
# Proxy puro verso llama-swap: salta CLI lms, /api/v0, ensure_model_context, TTL, revive.
# Con 1, il ciclo di vita dei modelli (load/unload/VRAM) e' tutto di llama-swap.
LMSTUDIO_PROXY_PURE=1

# Capability dichiarate in GET /v1/models, per-modello (JSON su una riga).
# Senza questa variabile il gateway le deduce dal NOME del modello, e sbaglia:
# `qwen3-coder-30b` sa chiamare funzioni ma non ha "coder" tra le euristiche,
# `qwen3-vl-8b` vede ma il nome non basta a dedurlo. Chi interroga il gateway
# usa queste capability per instradare: una dichiarata e non vera e' peggio di
# un modello mancante, quindi vanno verificate sul campo prima di scriverle qui
# (scripts\prova-capability-modelli.py).
# LMSTUDIO_MODEL_CAPABILITIES={"qwen/qwen3-coder-30b":["chat","tools","coding"],"qwen/qwen3-vl-8b":["chat","tools","vision"]}
LMSTUDIO_MODEL_CAPABILITIES=
# Percorso esplicito a lms.exe (opzionale). Consigliato se il gateway non eredita PATH utente.
# LMSTUDIO_LMS_PATH=C:\Users\<user>\.lmstudio\bin\lms.exe

# Retry su 502/503 (modello in caricamento): tentativi e delay lineare tra tentativi.
# Consigliato per modelli 27B+:
#   LMSTUDIO_RETRY_MAX=8
#   LMSTUDIO_RETRY_DELAY_S=15
LMSTUDIO_RETRY_MAX=8
LMSTUDIO_RETRY_DELAY_S=15
# Retry breve su errori transitori chat (502 post-generazione, connessione rifiutata, model busy).
LMSTUDIO_CHAT_RETRY_MAX=3
LMSTUDIO_CHAT_RETRY_DELAY_S=0.4
# Tetto read chat verso llama-swap (secondi). Pool pieno -> 503 in ~POOL_TIMEOUT.
LMSTUDIO_CHAT_TIMEOUT_S=180
LMSTUDIO_CHAT_POOL_TIMEOUT_S=3
LMSTUDIO_CHAT_MAX_CONNECTIONS=16
# Senza chunk SSE per IDLE_S chiude TCP verso swap (kill -9 / docker stop).
LMSTUDIO_CHAT_IDLE_S=90
LMSTUDIO_CHAT_TTFB_S=300
LMSTUDIO_CHAT_REAPER_INTERVAL_S=2

# Warmup modelli LM Studio all'avvio server.
LMSTUDIO_WARMUP_ON_STARTUP=1

# Context/offload/parallel di DEFAULT forzati al load (CLI `lms load`). 0 / "" = non forzare.
LMSTUDIO_CONTEXT_LENGTH=16384
LMSTUDIO_GPU_OFFLOAD_RATIO=max
# Slot KV paralleli. Default LM Studio = 4; su MoE 16 GB usare 1 (vedi INSTALLAZIONE.md).
LMSTUDIO_PARALLEL=1

# TTL idle (secondi) su ogni chat verso LM Studio (gateway imposta body["ttl"]).
# Default 86400 = 24h dall'ultimo uso; 0 = non inviare (comportamento LM Studio).
# Gli unload espliciti (POST /v1/models/unload-all) restano efficaci.
# LMSTUDIO_TTL_S=86400

# Override context/offload/parallel PER-MODELLO (JSON su una riga). Sovrascrive i default sopra.
# Utile quando modelli diversi richiedono config diverse per entrare in VRAM.
# Match: uguaglianza esatta o sottostringa sull'id modello (case-insensitive).
# Esempio (RTX 5060 Ti 16 GB — MoE: ctx 16384 × parallel 1, mai lms load -c a mano):
# LMSTUDIO_MODEL_OVERRIDES={"gemma-4-26b-a4b-it":{"context":16384,"gpu":"max","parallel":1},"google/gemma-3-12b":{"context":16384,"gpu":"max"}}
LMSTUDIO_MODEL_OVERRIDES=

# ---------------------------------------------------------------
# Gateway OpenAI-compat (ereditato dal progetto 10)
# ---------------------------------------------------------------

# Elenco modelli esposti da /v1/models (separati da virgola).
# Vuoto = tutti quelli installati in Ollama.
# Esempio: MODEL_ALLOWLIST=qwen3:14b,qwen3-coder:30b-q2,qwen3-coder:30b-q3
MODEL_ALLOWLIST=

# TTL cache lista modelli (secondi).
MODELS_CACHE_TTL_S=300

# Intervallo (secondi) heartbeat whitespace per richieste non-streaming lunghe
# (evita che Cloudflare/proxy chiuda la connessione idle). 0 = disabilitato.
NON_STREAM_HEARTBEAT_INTERVAL_S=10

# Pre-carica lista modelli all'avvio (1 = si, 0 = no).
MODELS_WARMUP_ON_STARTUP=1

# Calcolo automatico num_ctx in base alla lunghezza del prompt.
AUTO_NUM_CTX=1
DEFAULT_NUM_CTX=8192
MAX_NUM_CTX=32768
NUM_CTX_CHARS_PER_TOKEN=3.2
NUM_CTX_SAFETY_TOKENS=512

# ---------------------------------------------------------------
# OCR Server (nuovo)
# ---------------------------------------------------------------

# Modello Ollama da usare per OCR. Deve essere gia' scaricato:
#   ollama pull glm-ocr
OCR_MODEL=glm-ocr
# Backend OCR: lmstudio | ollama | (vuoto=auto: lmstudio se modello presente, else ollama)
# OCR_BACKEND=lmstudio


# DPI di rendering per PDF -> immagine. 150 e' buon compromesso qualita'/velocita'.
# Aumentare a 200-300 per documenti con testo piccolo.
PDF_DPI=150

# Numero massimo di pagine processate per PDF (le successive vengono ignorate).
MAX_PAGES=50

# Keep-alive Ollama per glm-ocr su job multi-pagina (es. 30m). Vuoto = default Ollama.
# OCR_OLLAMA_KEEP_ALIVE=30m

# TTL (secondi) dei job in memoria. Dopo questo tempo il job viene eliminato.
JOB_TTL_S=3600

# Timeout (secondi) per la chiamata OCR verso Ollama (per singola pagina).
OCR_TIMEOUT_S=300

# Lato lungo massimo immagine in pixel. Immagini piu' grandi vengono ridimensionate.
IMAGE_MAX_SIDE=4000

# Max job OCR eseguiti in parallelo (default 1 = una richiesta alla volta su glm-ocr).
OCR_MAX_CONCURRENT_JOBS=1

# Max job in coda (non ancora avviati). 0 = illimitato. Se piena, POST /process -> 503.
OCR_QUEUE_MAX_SIZE=0

# Abilita POST /cancel/{job_id} e POST /cancel-all (0 = disabilita).
OCR_ALLOW_CANCEL=1

# Secondi di attesa per worker OCR in chiusura applicazione (graceful shutdown).
OCR_JOB_SHUTDOWN_GRACE_S=30

# ---------------------------------------------------------------
# Media Enhancement — SUPIR (opzionale, GPU NVIDIA dedicata)
# Setup automatico: .\setup_media.bat  oppure  .\scripts\setup_media.ps1
# Richiede Python 3.10 separato, ~25 GB disco, modelli NON in git.
# ---------------------------------------------------------------

# 1 = abilita POST /media/process e health media_ok
MEDIA_ENABLED=0

# Python del venv media (default se vuoto: .venv-media\Scripts\python.exe)
# MEDIA_VENV_PYTHON=

# Cartella pesi SUPIR/SDXL/CLIP (path assoluto consigliato, fuori dalla cartella server).
MEDIA_MODELS_DIR=D:\Model\media

# Profilo VRAM 12 GB (default): no LLaVA, tiled VAE, half params
# MEDIA_SUPIR_NO_LLAVA=1
# MEDIA_SUPIR_USE_TILE_VAE=1
# MEDIA_SUPIR_HALF_PARAMS=1

# Upscale default (2 o 4) e fedelta' 0.0-1.0 (piu' alto = piu' fedele all'originale)
# MEDIA_DEFAULT_UPSCALE=2
# MEDIA_DEFAULT_FIDELITY=0.85

# Timeout inferenza SUPIR per job (secondi). Primo job piu' lento (load modelli).
# MEDIA_INFERENCE_TIMEOUT_S=1800

# Max job media paralleli (consigliato 1 su GPU 12 GB)
# MEDIA_MAX_CONCURRENT_JOBS=1

# ---------------------------------------------------------------
# Whisper — trascrizione audio (opzionale)
# Setup automatico: .\setup_whisper.bat  oppure  .\scripts\setup_whisper.ps1
# Crea .venv-whisper (Python 3.10/3.11/3.12). Profilo CPU: nessuna GPU richiesta.
# ---------------------------------------------------------------

# 1 = abilita POST /v1/audio/transcriptions, /v1/audio/translations, /audio/transcribe
WHISPER_ENABLED=0

# Python del venv whisper (default se vuoto: .venv-whisper\Scripts\python.exe)
# WHISPER_VENV_PYTHON=

# Cartella cache modelli faster-whisper (path assoluto consigliato, fuori dalla cartella server).
WHISPER_MODELS_DIR=D:\Model\whisper

# Modello: tiny | base | small | medium | large-v3 (o path locale)
WHISPER_MODEL=large-v3

# Device: cpu | cuda. Su RTX 3060 12GB: cuda + float16 (large-v3 ~3-4 GB VRAM dopo unload LLM)
WHISPER_DEVICE=cuda
# compute_type: int8 (cpu) | float16 (cuda consigliato) | int8_float16
WHISPER_COMPUTE_TYPE=float16

# Prima di trascrivere su cuda, scarica modelli LM Studio dalla VRAM (default 1)
# WHISPER_AUTO_UNLOAD_LLMS=1

# Timeout download/prefetch modello via POST /whisper/download-model (secondi)
# WHISPER_DOWNLOAD_TIMEOUT_S=3600

# Lingua di default ISO 639-1 (es. it); vuoto = autodetect
# WHISPER_DEFAULT_LANGUAGE=
# WHISPER_BEAM_SIZE=5
# WHISPER_VAD_FILTER=1

# Job di trascrizione paralleli (default 1) e timeout per file (secondi)
# WHISPER_MAX_CONCURRENT_JOBS=1
# WHISPER_TIMEOUT_S=1800
# Dimensione massima upload audio in bytes (default 100 MB)
# WHISPER_MAX_INPUT_BYTES=104857600

# ---------------------------------------------------------------
# Voce esterna — speaches (OpenAI-compat STT/TTS)
# Se valorizzato, /v1/audio/transcriptions|translations|speech
# vengono inoltrate a questo URL (es. speaches su :8201).
# Vuoto = comportamento storico (Whisper interno se WHISPER_ENABLED).
# ---------------------------------------------------------------
# VOCE_URL=http://127.0.0.1:8201

# ---------------------------------------------------------------
# Decisori (Laya + Decision-4B) — un solo upstream FastAPI
# Prefisso id: decider:laya, decider:decision-4b
# POST /v1/decide inoltra a DECIDER_URL. Vuoto = off.
# ---------------------------------------------------------------
# DECIDER_URL=http://127.0.0.1:8098
# DECIDER_API_KEY=
# DECIDER_TIMEOUT_S=30
# DECIDER_MODELS=laya,decision-4b

# ---------------------------------------------------------------
# Logging
# ---------------------------------------------------------------

# Path del file di audit richieste (JSONL). Vuoto = disattivato.
# Ogni riga include: applicativo chiamante (se dichiarato), IP, modello,
# start/end, durata, status code e payload richiesta/risposta.
# Header opzionali supportati per identificare i client senza rompere i legacy:
#   X-Client-Name, X-Client-Id, X-Client-Version
REQUESTS_LOG_PATH=logs/requests.jsonl
